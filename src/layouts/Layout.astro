---
import '../styles/global.css';
import Background from '../components/Background.astro';
const { title = 'Enzler — Software, e-commerce y empresas digitales', description = 'Enzler desarrolla software a medida, tiendas online, landing pages y las empresas que los usan.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070a16" />
    <title>{title}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='24' fill='%237c6cff'/><text x='50' y='72' font-size='64' text-anchor='middle' fill='white' font-family='sans-serif' font-weight='700'>E</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Sora:wght@500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Background />
    <div class="relative z-10"><slot /></div>
  </body>
</html>