---
const { tag, title, text } = Astro.props;
---
<div data-reveal class="mb-16 max-w-3xl space-y-4">
  <span class="font-mono text-xs uppercase tracking-widest text-enzler-accent">{tag}</span>
  <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
  <p class="text-base leading-relaxed text-enzler-muted">{text}</p>
</div>