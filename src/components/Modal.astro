<div id="projectModal" role="dialog" aria-modal="true" aria-labelledby="modal-title" class="pointer-events-none fixed inset-0 z-50 flex items-center justify-center bg-black/80 p-4 opacity-0 backdrop-blur-md transition-opacity duration-300">
    <div class="glass-surface relative w-full max-w-xl space-y-6 rounded-2xl p-8 shadow-2xl">
      <div class="flex items-center justify-between border-b border-enzler-border pb-4">
        <div>
          <h3 id="modal-title" class="text-xl font-bold">Start an Engineering Engagement</h3>
          <p class="text-xs text-enzler-muted">Tell us about your upcoming software requirements.</p>
        </div>
        <button data-close-modal aria-label="Close" class="rounded-lg p-1 text-enzler-muted hover:bg-enzler-elevated hover:text-enzler-text">
          <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <form class="space-y-4">
        <div>
          <label class="mb-1 block font-mono text-xs uppercase text-enzler-muted" for="f-name">Your Name / Organization</label>
          <input id="f-name" type="text" required placeholder="e.g. Alex Mercer, CTO" class="w-full rounded-lg border border-enzler-border bg-enzler-surface px-4 py-2.5 text-sm focus:border-enzler-accent focus:outline-none" />
        </div>
        <div>
          <label class="mb-1 block font-mono text-xs uppercase text-enzler-muted" for="f-cat">Project Category</label>
          <select id="f-cat" class="w-full rounded-lg border border-enzler-border bg-enzler-surface px-4 py-2.5 text-sm focus:border-enzler-accent focus:outline-none">
            <option>Web Application Development</option><option>Enterprise System Architecture</option><option>Business Process Automation</option><option>Custom Software Engineering</option>
          </select>
        </div>
        <div>
          <label class="mb-1 block font-mono text-xs uppercase text-enzler-muted" for="f-msg">Project Scope & Details</label>
          <textarea id="f-msg" rows="4" required placeholder="Describe your technical requirements and business objectives..." class="w-full rounded-lg border border-enzler-border bg-enzler-surface px-4 py-2.5 text-sm focus:border-enzler-accent focus:outline-none"></textarea>
        </div>
        <button type="submit" class="w-full rounded-lg bg-enzler-accent py-3.5 font-semibold text-white shadow-lg shadow-enzler-accent/20 transition-colors hover:bg-blue-600">Submit Engagement Request ↗</button>
      </form>
      <div id="modalSuccess" class="hidden rounded-lg border border-emerald-500/30 bg-emerald-500/10 p-4 text-center font-mono text-xs text-emerald-400">✔ Engagement request submitted successfully. An engineering director will respond shortly.</div>
    </div>
