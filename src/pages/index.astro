---
import Layout from '../layouts/Layout.astro';

// Tu número con código de país, sin + ni espacios (Paraguay: 595...)
const WA = '595000000000';
const wa = (t: string) => `https://wa.me/${+595982473466}?text=${encodeURIComponent(t)}`;

const icon = {
  code: '<path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/>',
  cart: '<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/>',
  layout: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
  layers: '<path d="m12 2 10 5-10 5L2 7l10-5ZM2 17l10 5 10-5M2 12l10 5 10-5"/>',
};

const servicios = [
  { i: icon.code, t: 'Software a medida', d: 'Sistemas de gestión, paneles, APIs e integraciones diseñados para tu operación y listos para crecer contigo.', m: 'Quiero desarrollar un software a medida.', span: 'md:col-span-2' },
  { i: icon.cart, t: 'E-commerce', d: 'Tiendas online rápidas, con pagos, inventario y envíos conectados.', m: 'Quiero crear una tienda online.', span: '' },
  { i: icon.layout, t: 'Landing pages', d: 'Páginas rápidas, animadas y pensadas para convertir visitas en clientes.', m: 'Quiero una landing page.', span: '' },
  { i: icon.layers, t: 'Nuevas empresas', d: 'Si tienes una idea, Enzler la construye como empresa: marca, producto y plataforma en un solo equipo.', m: 'Tengo una idea y quiero convertirla en empresa.', span: 'md:col-span-2' },
];

const pasos = [
  ['Conversamos', 'Nos cuentas tu idea por WhatsApp. Sin formularios.'],
  ['Definimos', 'Alcance, tiempos y precio claros antes de empezar.'],
  ['Construimos', 'Entregas por etapas. Ves el avance en cada una.'],
  ['Lanzamos', 'Publicamos y te acompañamos después.'],
];

const stack = ['Astro', 'React', 'TypeScript', 'Node.js', 'Tailwind CSS', 'PostgreSQL', 'Shopify', 'WooCommerce', 'Laravel', 'Python'];

const Wa = `<svg viewBox="0 0 24 24" class="size-5" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l4.9-1.3A10 10 0 1 0 12 2ZM7 12m-1.2 0a1.2 1.2 0 1 0 2.4 0a1.2 1.2 0 1 0-2.4 0ZM12 12m-1.2 0a1.2 1.2 0 1 0 2.4 0a1.2 1.2 0 1 0-2.4 0ZM17 12m-1.2 0a1.2 1.2 0 1 0 2.4 0a1.2 1.2 0 1 0-2.4 0Z"/></svg>`;
const ico = (p: string) => `<svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${p}</svg>`;
---
<Layout>
  <!-- NAV -->
  <header class="fixed inset-x-4 top-4 z-30 mx-auto max-w-5xl">
    <nav class="glass flex items-center justify-between rounded-full py-2.5 pl-6 pr-2.5">
      <a href="#" class="font-display text-xl font-extrabold tracking-tight">Enzler<span class="text-accent2">.</span></a>
      <div class="hidden gap-8 text-sm font-medium text-muted md:flex">
        <a href="#servicios" class="transition hover:text-fg">Servicios</a>
        <a href="#proceso" class="transition hover:text-fg">Proceso</a>
        <a href="#contacto" class="transition hover:text-fg">Contacto</a>
      </div>
      <a href={wa('Hola Enzler, quiero hablar sobre un proyecto.')} target="_blank" rel="noopener" class="rounded-full bg-fg px-5 py-2.5 text-sm font-bold text-base transition hover:bg-accent hover:text-white">Hablar ahora</a>
    </nav>
  </header>

  <main>
    <!-- HERO -->
    <section class="mx-auto grid min-h-screen max-w-6xl items-center gap-14 px-5 pb-16 pt-32 lg:grid-cols-[1.15fr_.85fr]">
      <div>
        <div class="rise glass inline-flex items-center gap-2.5 rounded-full px-4 py-2 text-sm text-muted" style="--i:0">
          <span class="relative flex size-2.5">
            <span class="absolute inline-flex size-full rounded-full bg-wa" style="animation: ping-soft 1.8s ease-out infinite"></span>
            <span class="relative inline-flex size-2.5 rounded-full bg-wa"></span>
          </span>
          Disponible para nuevos proyectos
        </div>
        <h1 class="rise mt-7 font-display text-[clamp(2.6rem,6.4vw,5.2rem)] font-extrabold leading-[1.02] tracking-tight" style="--i:1">
          Creamos software y empresas digitales que escalan.
        </h1>
        <p class="rise mt-6 max-w-xl text-lg leading-relaxed text-muted" style="--i:2">
          Enzler es la casa detrás de múltiples empresas. Desarrollamos software a medida, tiendas online y landing pages con ingeniería sólida y diseño cuidado.
        </p>
        <div class="rise mt-10 flex flex-wrap gap-3" style="--i:3">
          <a href={wa('Hola Enzler, quiero empezar un proyecto.')} target="_blank" rel="noopener" class="inline-flex items-center gap-2.5 rounded-full bg-wa px-7 py-4 font-bold text-base shadow-[0_10px_40px_-10px_rgba(37,211,102,.7)] transition hover:-translate-y-0.5 active:translate-y-0"><Fragment set:html={Wa} />Escríbenos por WhatsApp</a>
          <a href="#servicios" class="glass rounded-full px-7 py-4 font-bold transition hover:border-accent/60">Ver servicios</a>
        </div>
      </div>

      <!-- Tarjeta con inclinación -->
      <div class="rise" style="--i:3; perspective: 1000px">
        <div id="tilt" class="glass spot rounded-3xl p-7 shadow-2xl shadow-accent/10 transition-transform duration-200 ease-out">
          <div class="flex items-center justify-between">
            <span class="font-display text-lg font-bold">Ecosistema Enzler</span>
            <span class="flex gap-1.5"><i class="size-2.5 rounded-full bg-white/20"></i><i class="size-2.5 rounded-full bg-white/20"></i><i class="size-2.5 rounded-full bg-white/20"></i></span>
          </div>
          <ul class="mt-6 space-y-3">
            {servicios.map((s) => (
              <li class="flex items-center gap-4 rounded-2xl border border-white/5 bg-white/[.03] p-4">
                <span class="grid size-11 place-items-center rounded-xl bg-accent/15 text-accent2"><Fragment set:html={ico(s.i)} /></span>
                <span class="font-medium">{s.t}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 text-sm text-muted">Una casa. Múltiples empresas.</p>
        </div>
      </div>
    </section>

    <!-- TECNOLOGÍAS -->
    <section class="border-y border-white/5 py-7" aria-label="Tecnologías">
      <div class="marquee overflow-hidden">
        <div class="marquee-track gap-12 text-lg font-display font-semibold text-muted/80">
          {[...stack, ...stack].map((s) => <span class="px-6">{s}</span>)}
        </div>
      </div>
    </section>

    <!-- SERVICIOS -->
    <section id="servicios" class="mx-auto max-w-6xl px-5 py-28">
      <h2 class="max-w-2xl font-display text-4xl font-extrabold tracking-tight md:text-5xl">Lo que desarrollamos</h2>
      <p class="mt-4 max-w-xl text-lg text-muted">De una landing a una plataforma completa, con el mismo estándar de calidad.</p>
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {servicios.map((s) => (
          <article class={`glass spot flex flex-col rounded-3xl p-8 transition hover:border-accent/40 ${s.span}`}>
            <span class="grid size-12 place-items-center rounded-2xl bg-accent/15 text-accent2"><Fragment set:html={ico(s.i)} /></span>
            <h3 class="mt-6 font-display text-2xl font-bold">{s.t}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-muted">{s.d}</p>
            <a href={wa(s.m)} target="_blank" rel="noopener" class="mt-6 inline-flex items-center gap-2 font-bold text-wa transition hover:gap-3"><Fragment set:html={Wa} />Consultar por WhatsApp</a>
          </article>
        ))}
      </div>
    </section>

    <!-- PROCESO -->
    <section id="proceso" class="mx-auto max-w-6xl px-5 pb-28">
      <h2 class="max-w-2xl font-display text-4xl font-extrabold tracking-tight md:text-5xl">De la idea al lanzamiento en cuatro pasos</h2>
      <ol class="relative mt-14 grid gap-10 md:grid-cols-4">
        <div class="absolute left-0 right-0 top-[7px] hidden h-px bg-gradient-to-r from-accent via-accent2 to-transparent md:block"></div>
        {pasos.map(([t, d], i) => (
          <li class="relative">
            <span class="relative z-10 block size-4 rounded-full bg-accent2 shadow-[0_0_0_6px_rgba(76,201,240,.15)]"></span>
            <span class="mt-5 block text-sm font-bold text-accent2">Paso {i + 1}</span>
            <h3 class="mt-1 font-display text-2xl font-bold">{t}</h3>
            <p class="mt-2 leading-relaxed text-muted">{d}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- CONTACTO -->
    <section id="contacto" class="mx-auto max-w-6xl px-5 pb-28">
      <div class="glass spot rounded-[2rem] px-6 py-20 text-center md:px-16">
        <h2 class="mx-auto max-w-3xl font-display text-4xl font-extrabold tracking-tight md:text-6xl">¿Tienes un proyecto en mente?</h2>
        <p class="mx-auto mt-5 max-w-md text-lg text-muted">Cuéntanos qué necesitas. Respondemos directamente por WhatsApp.</p>
        <a href={wa('Hola Enzler, tengo un proyecto y quiero una cotización.')} target="_blank" rel="noopener" class="mt-10 inline-flex items-center gap-2.5 rounded-full bg-wa px-9 py-5 text-lg font-bold text-base shadow-[0_10px_50px_-10px_rgba(37,211,102,.8)] transition hover:-translate-y-0.5 active:translate-y-0"><Fragment set:html={Wa} />Pedir cotización</a>
      </div>
    </section>
  </main>

  <footer class="border-t border-white/5 px-5 py-8 text-sm text-muted">
    <div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-2">
      <span>© {new Date().getFullYear()} Enzler. Todos los derechos reservados.</span>
      <span>Software, e-commerce y landing pages</span>
    </div>
  </footer>

  <a href={wa('Hola Enzler, quiero más información.')} target="_blank" rel="noopener" aria-label="Escribir por WhatsApp" class="fixed bottom-5 right-5 z-40 grid size-14 place-items-center rounded-full bg-wa text-base shadow-[0_10px_40px_-8px_rgba(37,211,102,.8)] transition hover:scale-110"><Fragment set:html={Wa} /></a>

  <script>
    // Luz que sigue al mouse en cada tarjeta
    document.querySelectorAll<HTMLElement>('.spot').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty('--mx', `${e.clientX - r.left}px`);
        el.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    });
    // Inclinación de la tarjeta del hero
    const tilt = document.getElementById('tilt');
    if (tilt && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      addEventListener('pointermove', (e) => {
        const rx = (e.clientY / innerHeight - 0.5) * -8;
        const ry = (e.clientX / innerWidth - 0.5) * 10;
        tilt.style.transform = `rotateX(${rx}deg) rotateY(${ry}deg)`;
      });
    }
  </script>
</Layout>